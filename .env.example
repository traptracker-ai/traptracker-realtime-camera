# Trap Tracker Real-Time Camera App example environment file
# Copy to .env only if you want to override Docker Compose defaults.
# Do not commit a real .env file to GitHub.

HOST=0.0.0.0
PORT=8501

# Model configuration
MODEL_DIR=/app/models
INPUT_SIZE=640
CONF_THRESHOLD=0.10
ORT_PROVIDERS=CPUExecutionProvider

# Runtime folders inside the container
DATA_DIR=/app/data
PROJECTS_DIR=/app/projects

# Polling intervals
POLL_EMAIL_SECONDS=30
POLL_INBOUND_SECONDS=10

# Optional Flask session key. If unset, the app generates and persists one in data/.secret_key
SECRET_KEY=replace_with_a_random_secret_for_local_use
